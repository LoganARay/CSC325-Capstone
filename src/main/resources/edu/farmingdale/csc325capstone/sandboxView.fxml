<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.control.TextField?>
<AnchorPane prefHeight="650.0" prefWidth="800.0" stylesheets="@savedBuild-GamesSearch.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.farmingdale.csc325capstone.SandboxViewController">
  <children>
    <HBox layoutY="56.8" prefHeight="546.0" prefWidth="800.0" spacing="24" style="-fx-padding: 20 24;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="57.0">
      <children>
        <VBox prefWidth="520" spacing="12">
          <children>
            <Label style="-fx-font-size: 30;" styleClass="title" text="Build Your PC">
                     <font>
                        <Font name="System Bold" size="30.0" />
                     </font></Label>
              <TextField fx:id="buildName" promptText="New Build" style="-fx-font-size: 20;" styleClass="text-field"></TextField>
              <VBox spacing="6">
              <children>
                <Label styleClass="partSection" text="CPU">
                           <font>
                              <Font size="15.0" />
                           </font></Label>
                <ComboBox fx:id="cpuCombo" prefWidth="500" promptText="Search CPU..." styleClass="list-view" />
              </children>
            </VBox>

            <VBox spacing="6">
              <children>
                <Label styleClass="partSection" text="GPU">
                           <font>
                              <Font size="15.0" />
                           </font></Label>
                <ComboBox fx:id="gpuCombo" prefWidth="500" promptText="Search GPU..." styleClass="list-view" />
              </children>
            </VBox>

            <VBox spacing="6">
              <children>
                <Label styleClass="partSection" text="RAM">
                           <font>
                              <Font size="15.0" />
                           </font></Label>
                <ComboBox fx:id="ramCombo" prefWidth="500" promptText="Search RAM..." styleClass="list-view" />
              </children>
            </VBox>

            <VBox spacing="6">
              <children>
                <Label styleClass="partSection" text="Motherboard">
                           <font>
                              <Font size="15.0" />
                           </font></Label>
                <ComboBox fx:id="motherboardCombo" prefWidth="500" promptText="Search Motherboard..." styleClass="list-view" />
              </children>
            </VBox>

            <VBox spacing="6">
              <children>
                <Label styleClass="partSection" text="Storage">
                           <font>
                              <Font size="15.0" />
                           </font></Label>
                <ComboBox fx:id="storageCombo" prefWidth="500" promptText="Search Storage..." styleClass="list-view" />
              </children>
            </VBox>

            <VBox spacing="6">
              <children>
                <Label styleClass="partSection" text="PSU">
                           <font>
                              <Font size="15.0" />
                           </font></Label>
                <ComboBox fx:id="psuCombo" prefWidth="500" promptText="Search PSU..." styleClass="list-view" />
              </children>
            </VBox>

            <VBox spacing="6">
              <children>
                <Label styleClass="partSection" text="Case">
                           <font>
                              <Font size="15.0" />
                           </font></Label>
                <ComboBox fx:id="caseCombo" prefWidth="500" promptText="Search Case..." styleClass="list-view" />
              </children>
            </VBox>
          </children>
        </VBox>

        <VBox prefHeight="471.0" prefWidth="212.0" spacing="12">
          <children>
            <Label styleClass="title" text="Summary">
                     <font>
                        <Font name="System Bold" size="25.0" />
                     </font></Label>

            <VBox spacing="4">
              <children>
                <Label styleClass="partSection" text="Total Cost">
                           <font>
                              <Font size="15.0" />
                           </font></Label>
                        <HBox prefHeight="19.0" prefWidth="210.0">
                           <children>
                              <Label fx:id="totalCostLabel" style="-fx-font-size: 20;" styleClass="partSection" text="\$">
                                 <font>
                                    <Font size="20.0" />
                                 </font>
                              </Label>
                              <Label fx:id="totalCostNumber" style="-fx-font-size: 20;" styleClass="partSection" text=" 0">
                                 <font>
                                    <Font size="20.0" />
                                 </font>
                              </Label>
                           </children>
                        </HBox>
              </children>
            </VBox>

            <VBox spacing="4">
              <children>
                <Label styleClass="partSection" text="Total Wattage">
                           <font>
                              <Font size="15.0" />
                           </font></Label>
                        <HBox prefHeight="100.0" prefWidth="200.0">
                           <children>
                      <Label fx:id="totalWattage" styleClass="partSection" text="0">
                                 <font>
                                    <Font size="15.0" />
                                 </font>
                              </Label>
                              <Label fx:id="totalWLabel" styleClass="partSection" text=" W">
                                 <font>
                                    <Font name="System Bold" size="15.0" />
                                 </font>
                              </Label>
                           </children>
                        </HBox>
              </children>
            </VBox>

              <Label styleClass="partSection" text="Selected Parts" />
              <VBox fx:id="detailsVBox" spacing="4" prefHeight="200"
                    style="-fx-padding: 8;" />

            <HBox spacing="8">
              <children>
                <Button fx:id="clearButton" onAction="#clearBuildHandle" styleClass="primaryButton" text="Clear">
                           <font>
                              <Font size="15.0" />
                           </font></Button>
                <Button fx:id="saveButton" onAction="#saveBuildHandle" styleClass="primaryButton" text="Save">
                           <font>
                              <Font size="15.0" />
                           </font>
                           <HBox.margin>
                              <Insets left="10.0" />
                           </HBox.margin></Button>
              </children>
            </HBox>
          </children>
        </VBox>
      </children>
    </HBox>
      <Button fx:id="homeButton" layoutX="536.0" layoutY="10.0" onAction="#handleHome" style="-fx-background-radius: 12; -fx-padding: 6 16; -fx-font-size: 13px; -fx-font-weight: 700;" styleClass="primaryButton" text="Home" />
      <Button fx:id="viewSavedButton" layoutX="623.0" layoutY="10.0" onAction="#handleViewSavedBuild" style="-fx-background-radius: 12; -fx-padding: 6 16; -fx-font-size: 13; -fx-font-weight: 700;" styleClass="primaryButton" text="Saved" />
      <Button fx:id="loginButton" layoutX="703.0" layoutY="10.0" onAction="#handleLogin" style="-fx-background-radius: 12; -fx-padding: 6 16; -fx-font-size: 13; -fx-font-weight: 700;" styleClass="primaryButton" text="Login" />
      <Label layoutX="10.0" layoutY="10.0" styleClass="title" text="Steam Builder">
         <font>
            <Font name="System Bold" size="25.0" />
         </font>
      </Label>
  </children>
</AnchorPane>
