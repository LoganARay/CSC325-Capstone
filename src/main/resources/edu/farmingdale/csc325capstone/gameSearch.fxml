<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="750.0" prefWidth="950.0" stylesheets="@savedBuild-GamesSearch.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.farmingdale.csc325capstone.gameSearchController">
  <children>
    <HBox alignment="CENTER_LEFT" spacing="16" style="-fx-padding: 12 16;" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
      <children>
        <Label prefHeight="51.0" prefWidth="267.0" styleClass="SteamBuildertitle" text="Steam Builder">
               <font>
                  <Font size="36.0" />
               </font></Label>
            <Region prefHeight="51.0" prefWidth="353.0" />
        <HBox alignment="CENTER_RIGHT" spacing="10" AnchorPane.rightAnchor="0.0" HBox.hgrow="ALWAYS">
          <children>
            <Button fx:id="homeButton" onAction="#handleHome" styleClass="menuButton" text="Home" />
            <Button fx:id="savedButton" onAction="#handleSavedBuild" styleClass="menuButton" text="Saved" />
          </children>
        </HBox>
      </children>
    </HBox>

    <HBox layoutY="87.2" prefHeight="690.0" prefWidth="950.0" spacing="20.0" style="-fx-padding: 14;" AnchorPane.bottomAnchor="-27.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="87.0">
      <children>
        <!-- Left: search + list -->
        <VBox prefHeight="674.0" prefWidth="370.0" spacing="8" HBox.hgrow="ALWAYS">
          <children>
            <Label styleClass="title" text="Game Requirements" />
            <TextField fx:id="searchField" promptText="Search games..." styleClass="text-field" VBox.vgrow="ALWAYS">
                     <font>
                        <Font size="14.0" />
                     </font></TextField>
            <ListView fx:id="gamesListView" prefHeight="554.0" prefWidth="381.0" />
          </children>
        </VBox>

        <!-- Right: details -->
        <VBox prefHeight="674.0" prefWidth="510.0" spacing="6" HBox.hgrow="ALWAYS">
          <children>
            <Label styleClass="title" text="Select a Game" />
            <Label fx:id="gameStudioLabel" styleClass="normalText" text="Game name here" />

            <Label styleClass="partSection" text="Minimum Requirements" />
            <VBox spacing="3" style="-fx-padding: 8;" styleClass="cardVbox">
              <children>
                <Label styleClass="partField-label" text="CPU" />
                <Label fx:id="minCpuLabel" styleClass="normalText" />
              </children>
            </VBox>
            <VBox spacing="3" style="-fx-padding: 8;" styleClass="cardVbox">
              <children>
                <Label styleClass="partField-label" text="GPU" />
                <Label fx:id="minGpuLabel" styleClass="normalText" text="" />
              </children>
            </VBox>
            <VBox spacing="3" style="-fx-padding: 8;" styleClass="cardVbox">
              <children>
                <Label styleClass="partField-label" text="RAM" />
                <Label fx:id="minRamLabel" styleClass="normalText" text="" />
              </children>
            </VBox>

            <Label styleClass="partSection" text="Recommended Requirements" />
            <VBox spacing="3" style="-fx-padding: 8;" styleClass="cardVbox">
              <children>
                <Label styleClass="partField-label" text="CPU" />
                <Label fx:id="recCpuLabel" styleClass="normalText" text="" />
              </children>
            </VBox>
            <VBox spacing="3" style="-fx-padding: 8;" styleClass="cardVbox">
              <children>
                <Label styleClass="partField-label" text="GPU" />
                <Label fx:id="recGpuLabel" styleClass="normalText" text="" />
              </children>
            </VBox>
            <VBox spacing="3" style="-fx-padding: 8;" styleClass="cardVbox">
              <children>
                <Label styleClass="partField-label" text="RAM" />
                <Label fx:id="recRamLabel" styleClass="normalText" text="" />
              </children>
            </VBox>
            <VBox spacing="3" style="-fx-padding: 8;" styleClass="cardVbox">
              <children>
                <Label styleClass="partField-label" text="Storage" />
                <Label fx:id="recStorageLabel" styleClass="normalText" text="" />
              </children>
            </VBox>

            <Button fx:id="buildButton" onAction="#buildButtonHandle" styleClass="primaryButton" text="Go to Sandbox" />
          </children>
               <padding>
                  <Insets left="20.0" />
               </padding>
        </VBox>
      </children>
    </HBox>
  </children>
</AnchorPane>
