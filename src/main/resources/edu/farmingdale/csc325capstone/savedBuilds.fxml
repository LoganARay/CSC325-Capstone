<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="750.0" prefWidth="950.0" stylesheets="@savedBuild-GamesSearch.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.farmingdale.csc325capstone.ViewModel.SavedBuildsViewController">
  <children>
    <HBox alignment="CENTER_LEFT" spacing="16" style="-fx-padding: 12 16;" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
      <children>
        <Label styleClass="SteamBuildertitle" text="Steam Builder" />
            <Region prefHeight="36.0" prefWidth="558.0" />
        <HBox alignment="CENTER_RIGHT" spacing="10" AnchorPane.rightAnchor="0.0" HBox.hgrow="ALWAYS">
          <children>
            <Button fx:id="homeButton" onAction="#handleHome" styleClass="menuButton" text="Home" />
          </children>
        </HBox>
      </children>
    </HBox>

    <HBox layoutY="66.4" prefHeight="684.0" prefWidth="950.0" spacing="12" style="-fx-padding: 14;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="66.0">
      <children>
        <!-- Left: search + list -->
        <VBox prefHeight="674.0" prefWidth="370.0" spacing="8" HBox.hgrow="ALWAYS">
          <children>
            <Label styleClass="title" text="Saved Builds" />
            <ListView fx:id="gamesListView" prefHeight="520" prefWidth="394.0">
                     <VBox.margin>
                        <Insets top="20.0" />
                     </VBox.margin></ListView>
          </children>
               <HBox.margin>
                  <Insets />
               </HBox.margin>
        </VBox>
            <Region prefHeight="655.0" prefWidth="0.0" HBox.hgrow="ALWAYS" />

        <!-- Right: details -->
        <VBox prefHeight="674.0" prefWidth="510.0" spacing="6">
          <children>
            <Label styleClass="title" text="PC Parts" />
                  <VBox prefWidth="520" spacing="12" VBox.vgrow="ALWAYS">
                     <children>
                        <VBox spacing="6">
                           <children>
                              <Label styleClass="partSection" text="CPU">
                                 <font>
                                    <Font size="15.0" />
                                 </font>
                              </Label>
                              <ComboBox fx:id="cpuCombo" prefWidth="500" promptText="Search CPU..." styleClass="list-view" />
                           </children>
                        </VBox>
                        <VBox spacing="6">
                           <children>
                              <Label styleClass="partSection" text="GPU">
                                 <font>
                                    <Font size="15.0" />
                                 </font>
                              </Label>
                              <ComboBox fx:id="gpuCombo" prefWidth="500" promptText="Search GPU..." styleClass="list-view" />
                           </children>
                        </VBox>
                        <VBox spacing="6">
                           <children>
                              <Label styleClass="partSection" text="RAM">
                                 <font>
                                    <Font size="15.0" />
                                 </font>
                              </Label>
                              <ComboBox fx:id="ramCombo" prefWidth="500" promptText="Search RAM..." styleClass="list-view" />
                           </children>
                        </VBox>
                        <VBox spacing="6">
                           <children>
                              <Label styleClass="partSection" text="Motherboard">
                                 <font>
                                    <Font size="15.0" />
                                 </font>
                              </Label>
                              <ComboBox fx:id="motherboardCombo" prefWidth="500" promptText="Search Motherboard..." styleClass="list-view" />
                           </children>
                        </VBox>
                        <VBox spacing="6">
                           <children>
                              <Label style="-fx-font-weight: 600;" styleClass="partSection" text="Storage">
                                 <font>
                                    <Font size="15.0" />
                                 </font>
                              </Label>
                              <ComboBox fx:id="storageCombo" prefWidth="500" promptText="Search Storage..." styleClass="list-view" />
                           </children>
                        </VBox>
                        <VBox spacing="6">
                           <children>
                              <Label styleClass="partSection" text="PSU">
                                 <font>
                                    <Font size="15.0" />
                                 </font>
                              </Label>
                              <ComboBox fx:id="psuCombo" prefWidth="500" promptText="Search PSU..." styleClass="list-view" />
                           </children>
                        </VBox>
                        <VBox spacing="6">
                           <children>
                              <Label styleClass="partSection" text="Case">
                                 <font>
                                    <Font size="15.0" />
                                 </font>
                              </Label>
                              <ComboBox fx:id="caseCombo" prefWidth="500" promptText="Search Case..." styleClass="list-view" />
                           </children>
                        </VBox>
                     </children>
                  </VBox>

                        <Button fx:id="buildButton" onAction="#buildButtonHandle" styleClass="primaryButton" text="Go to Sandbox">
                     <VBox.margin>
                        <Insets top="20.0" />
                     </VBox.margin>
                  </Button>
          </children>
               <padding>
                  <Insets left="20.0" />
               </padding>
        </VBox>
            <Region prefHeight="655.0" prefWidth="10.0" HBox.hgrow="ALWAYS" />
      </children>
    </HBox>
  </children>
</AnchorPane>
