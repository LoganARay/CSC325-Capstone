<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>


<VBox fx:id="mainContainer" spacing="20"
      prefWidth="Infinity"
      stylesheets="@questionnaire.css"
      xmlns:fx="http://javafx.com/fxml/1"
      xmlns="http://javafx.com/javafx/11.0.14-internal"
      fx:controller="edu.farmingdale.csc325capstone.QuestionnaireController">

    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <HBox spacing="20" VBox.vgrow="ALWAYS">

        <!-- LEFT PANEL: question info -->
        <VBox spacing="16" prefWidth="300" minWidth="220">
            <Label fx:id="questionCounter" styleClass="question-counter" text="Question 1 of 7" />
            <Label fx:id="questionText" styleClass="question-text" text="What is your budget range?" wrapText="true" />
            <Label fx:id="questionHint" styleClass="question-hint" text="This drives the overall tier of PC recommended." wrapText="true" />

            <Region VBox.vgrow="ALWAYS"/>

            <Button text="← Home"
                    maxWidth="Infinity"
                    onAction="#onHomeClicked"
                    styleClass="next-button"/>
        </VBox>

        <!-- RIGHT PANEL: answer buttons -->
        <VBox fx:id="rightPanel" spacing="12" styleClass="question-card" HBox.hgrow="ALWAYS">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>

            <HBox fx:id="imageContainer" alignment="CENTER" styleClass="pc-image-container" visible="false" managed="false">
                <ImageView fx:id="pcImageView"
                           fitWidth="500"
                           fitHeight="350"
                           preserveRatio="true"/>
            </HBox>

            <VBox fx:id="budgetOptions" spacing="8">
                <Button fx:id="budgetBtn1" maxWidth="Infinity" styleClass="answer-button" text="Under 500" />
                <Button fx:id="budgetBtn2" maxWidth="Infinity" styleClass="answer-button" text="500 - 1,000" />
                <Button fx:id="budgetBtn3" maxWidth="Infinity" styleClass="answer-button" text="1,000 - 1,500" />
                <Button fx:id="budgetBtn4" maxWidth="Infinity" styleClass="answer-button" text="1,500+" />
            </VBox>

            <VBox fx:id="gameList" spacing="8">
                <Label fx:id="gameArea" maxWidth="Infinity" text="Selected Games: " />
            </VBox>

            <VBox fx:id="gameSearch" spacing="8">
                <TextField fx:id="searchField" maxWidth="Infinity" promptText="Search..." />
            </VBox>

            <VBox fx:id="playStyleOptions" spacing="8">
                <Button fx:id="playBtn1" maxWidth="Infinity" styleClass="answer-button" text="Online competitive multiplayer" />
                <Button fx:id="playBtn2" maxWidth="Infinity" styleClass="answer-button" text="Online casual / co-op with friends" />
                <Button fx:id="playBtn3" maxWidth="Infinity" styleClass="answer-button" text="Solo / offline single-player" />
                <Button fx:id="playBtn4" maxWidth="Infinity" styleClass="answer-button" text="A mix of everything" />
            </VBox>

            <VBox fx:id="performanceOptions" spacing="8">
                <Button fx:id="perfBtn1" maxWidth="Infinity" styleClass="answer-button" text="1080p / 60 fps" />
                <Button fx:id="perfBtn2" maxWidth="Infinity" styleClass="answer-button" text="1080p / 144+ fps" />
                <Button fx:id="perfBtn3" maxWidth="Infinity" styleClass="answer-button" text="1440p / high settings" />
                <Button fx:id="perfBtn4" maxWidth="Infinity" styleClass="answer-button" text="4K / max settings" />
            </VBox>

            <VBox fx:id="storageOptions" spacing="8">
                <Button fx:id="storageBtn1" maxWidth="Infinity" styleClass="answer-button" text="256 - 500 GB" />
                <Button fx:id="storageBtn2" maxWidth="Infinity" styleClass="answer-button" text="1 TB" />
                <Button fx:id="storageBtn3" maxWidth="Infinity" styleClass="answer-button" text="2 TB" />
                <Button fx:id="storageBtn4" maxWidth="Infinity" styleClass="answer-button" text="2 TB+" />
            </VBox>

            <VBox fx:id="priorityOptions" spacing="8">
                <Button fx:id="priorityBtn1" maxWidth="Infinity" styleClass="answer-button" text="Best raw performance" />
                <Button fx:id="priorityBtn2" maxWidth="Infinity" styleClass="answer-button" text="Best value for money" />
                <Button fx:id="priorityBtn3" maxWidth="Infinity" styleClass="answer-button" text="Reliability / brand reputation" />
                <Button fx:id="priorityBtn4" maxWidth="Infinity" styleClass="answer-button" text="Looks / aesthetics" />
            </VBox>

            <VBox fx:id="longevityOptions" spacing="8">
                <Button fx:id="longevityBtn1" maxWidth="Infinity" styleClass="answer-button" text="1 - 2 years" />
                <Button fx:id="longevityBtn2" maxWidth="Infinity" styleClass="answer-button" text="3 - 4 years" />
                <Button fx:id="longevityBtn3" maxWidth="Infinity" styleClass="answer-button" text="5+ years" />
                <Button fx:id="longevityBtn4" maxWidth="Infinity" styleClass="answer-button" text="Not sure" />
            </VBox>



            <Button fx:id="nextButton" maxWidth="Infinity" onAction="#onNextClicked" styleClass="next-button" text="Next" />

            <!-- View All Button -->
            <Button fx:id="viewAllBtn" maxWidth="Infinity" onAction="#onViewAllSuggestionsClicked"
                    styleClass="next-button" text="View All Suggestions"
                    visible="false" managed="false"/>

            <!-- All Suggestions Pane (3 cards) -->
            <Pane fx:id="allSuggestionsPane" visible="false" managed="false">
                <VBox spacing="16">
                    <!-- Card 1 -->
                    <VBox fx:id="card1" spacing="6" styleClass="question-card">
                        <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                        <Label fx:id="medal1" styleClass="question-counter" text="🥇 1st Place"/>
                        <ImageView fx:id="img1" fitWidth="200" fitHeight="140" preserveRatio="true"/>
                        <Label fx:id="name1" styleClass="question-text" wrapText="true"/>
                        <Label fx:id="specs1" styleClass="question-hint" wrapText="true"/>
                        <Label fx:id="price1" styleClass="question-text"/>
                        <Button maxWidth="Infinity" onAction="#onViewDeal1Clicked" styleClass="next-button" text="View Deal"/>
                    </VBox>
                    <!-- Card 2 -->
                    <VBox fx:id="card2" spacing="6" styleClass="question-card">
                        <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                        <Label fx:id="medal2" styleClass="question-counter" text="🥈 2nd Place"/>
                        <ImageView fx:id="img2" fitWidth="200" fitHeight="140" preserveRatio="true"/>
                        <Label fx:id="name2" styleClass="question-text" wrapText="true"/>
                        <Label fx:id="specs2" styleClass="question-hint" wrapText="true"/>
                        <Label fx:id="price2" styleClass="question-text"/>
                        <Button maxWidth="Infinity" onAction="#onViewDeal2Clicked" styleClass="next-button" text="View Deal"/>
                    </VBox>
                    <!-- Card 3 -->
                    <VBox fx:id="card3" spacing="6" styleClass="question-card">
                        <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                        <Label fx:id="medal3" styleClass="question-counter" text="🥉 3rd Place"/>
                        <ImageView fx:id="img3" fitWidth="200" fitHeight="140" preserveRatio="true"/>
                        <Label fx:id="name3" styleClass="question-text" wrapText="true"/>
                        <Label fx:id="specs3" styleClass="question-hint" wrapText="true"/>
                        <Label fx:id="price3" styleClass="question-text"/>
                        <Button maxWidth="Infinity" onAction="#onViewDeal3Clicked" styleClass="next-button" text="View Deal"/>
                    </VBox>
                    <Button maxWidth="Infinity" onAction="#onBackToRecommendationClicked"
                            styleClass="next-button" text="← Back"/>
                </VBox>
            </Pane>

        </VBox>
    </HBox>

</VBox>